<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <title>Cardio_IoT Didáctica</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      background: #f5f5f5;
      margin: 0;
      padding: 20px;
    }

    h1 {
      margin-top: 20px;
    }

    .relay-container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      margin-top: 30px;
    }

    .relay-card {
      background: white;
      width: 220px;
      padding: 20px;
      border-radius: 15px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .relay-card button {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 10px;
      color: white;
      font-size: 16px;
      cursor: pointer;
    }

    #allOffBtn {
      margin-top: 30px;
      padding: 15px 25px;
      border: none;
      border-radius: 10px;
      background: #d32f2f;
      color: white;
      font-size: 16px;
      cursor: pointer;
    }

    #loading {
      margin-top: 50px;
      font-size: 20px;
    }
  </style>
</head>

<body>

  <h1>Cardio_IoT Didáctica</h1>
  <h3>Modelo del Dr. Edgar Armando Urrego Ph.D.</h3>

  <!-- <div id="loading">
    Conectando con Firebase...
  </div> -->

  <div id="dashboard" style="display:none;">

    <div class="relay-container">

      <div class="relay-card">
        <h2>Vena Cava Superior</h2>
        <p id="status1">OFF</p>
        <button id="btn1">Cargando...</button>
      </div>

      <div class="relay-card">
        <h2>Arteria Aorta</h2>
        <p id="status2">OFF</p>
        <button id="btn2">Cargando...</button>
      </div>

      <div class="relay-card">
        <h2>Arteria Pulmonar</h2>
        <p id="status3">OFF</p>
        <button id="btn3">Cargando...</button>
      </div>

      <div class="relay-card">
        <h2>Orejuela de Aurícula Derecha</h2>
        <p id="status4">OFF</p>
        <button id="btn4">Cargando...</button>
      </div>

      <div class="relay-card">
        <h2>Orejuela de Aurícula Izquierda</h2>
        <p id="status5">OFF</p>
        <button id="btn5">Cargando...</button>
      </div>

      <div class="relay-card">
        <h2>Ventrínculo Izquierdo</h2>
        <p id="status6">OFF</p>
        <button id="btn6">Cargando...</button>
      </div>

      <div class="relay-card">
        <h2>Ventrínculo Derecho</h2>
        <p id="status7">OFF</p>
        <button id="btn7">Cargando...</button>
      </div>

      <div class="relay-card">
        <h2>Cámara 360°</h2>
        <p id="status8">OFF</p>
        <button id="btn8">Cargando...</button>
      </div>

    </div>

    <button id="allOffBtn">
      Desactivar Todos
    </button>

  </div>

  <!-- Firebase -->

  <script src="https://www.gstatic.com/firebasejs/9.6.10/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.6.10/firebase-database-compat.js"></script>

  <script>

    console.log("SCRIPT INICIADO");

    const firebaseConfig = {
      apiKey: "AIzaSyAhmntKDkhTXgpxvy0_egxKkdejc5FJO8k",
      databaseURL: "https://neurodidactica-cfeeb-default-rtdb.firebaseio.com"
    };

    // Inicializar Firebase
    firebase.initializeApp(firebaseConfig);

    // Database
    const db = firebase.database();

    // Mostrar dashboard
    document.getElementById("dashboard").style.display = "block";

    // Relays
    const relays = [
      "relay1",
      "relay2",
      "relay3",
      "relay4",
      "relay5",
      "relay6",
      "relay7",
      "relay8"
    ];

    initializeRelays();

    function initializeRelays() {

      relays.forEach((relay, index) => {

        const relayNumber = index + 1;

        const relayRef = db.ref(relay);

        const statusText =
          document.getElementById(`status${relayNumber}`);

        const button =
          document.getElementById(`btn${relayNumber}`);

        // Escuchar cambios Firebase
        relayRef.on("value", (snapshot) => {

          const state = snapshot.val() || false;

          console.log(relay, state);

          // TRUE = ON
          // FALSE = OFF

          statusText.innerText =
            state ? "ON" : "OFF";

          button.innerText =
            state ? "Desactivar" : "Activar";

          button.style.backgroundColor =
            state ? "green" : "red";

        });

        // Click botón
        button.onclick = async () => {

          try {

            const snapshot =
              await relayRef.get();

            const currentState =
              snapshot.val() || false;

            await relayRef.set(!currentState);

            console.log(
              relay,
              "nuevo estado:",
              !currentState
            );

          } catch (error) {

            console.error(error);

            alert(error.message);

          }

        };

      });

    }

    // Apagar todos
    document
      .getElementById("allOffBtn")
      .onclick = async () => {

        try {

          const updates = {};

          relays.forEach(relay => {
            updates[relay] = false;
          });

          await db.ref().update(updates);

          console.log("Todos OFF");

        } catch (error) {

          console.error(error);

        }

      };

  </script>



</body>

</html>
